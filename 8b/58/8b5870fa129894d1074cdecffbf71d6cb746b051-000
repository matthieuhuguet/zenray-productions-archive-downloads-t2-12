<!doctype html>
<!-- HDA text : definition unique, une instance par bloc de texte du visuel. -->
<html><head><meta charset="utf-8">
<style>
  @font-face { font-family:'Face'; src:url('{{fontFile}}'); }
  html, body { margin:0; padding:0; background:transparent; }
  .box {
    width:{{boxW}}px; height:{{boxH}}px;
    display:flex; align-items:center; justify-content:{{justify}};
  }
  .txt {
    font-family:'Face';
    font-size:{{size}}px;
    line-height:{{lineHeight}};
    letter-spacing:{{tracking}}em;
    color:{{color}};
    font-style:{{fontStyle}};
    white-space:nowrap;
  }
</style></head>
<body><div class="box"><div class="txt">{{text}}</div></div></body></html>
