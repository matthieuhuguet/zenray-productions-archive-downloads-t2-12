<!doctype html>
<html><head><meta charset="utf-8">
<style>
  @font-face { font-family: "GenericG50"; src: url("file:///Users/zenray/Library/Fonts/Generic-G50-CC-Typic-DEMO.otf") format("opentype"); }
  * { margin:0; padding:0; box-sizing:border-box; }
  html, body { background: transparent; }
  .wrap { width: 3600px; height: 1520px; display:flex; align-items:center; justify-content:center; }
  .cloudy {
    color: #fff;
    font-family: 'GenericG50', sans-serif;
    font-size: 960px;
    letter-spacing: -0.015em;
    line-height: 0.9;
    filter: url(#cloud) drop-shadow(0 0 20px rgba(255,255,255,.28)) drop-shadow(0 0 55px rgba(255,255,255,.16));
  }
</style></head>
<body>
  <svg width="0" height="0" style="position:absolute">
    <filter id="cloud" x="-60%" y="-60%" width="220%" height="220%">
      <feTurbulence type="fractalNoise" baseFrequency="0.02" numOctaves="4" seed="11" result="noise"/>
      <feDisplacementMap in="SourceGraphic" in2="noise" scale="4"
                         xChannelSelector="R" yChannelSelector="G" result="rough"/>
      <feGaussianBlur in="rough" stdDeviation="1.0"/>
    </filter>
  </svg>
  <div class="wrap"><div class="cloudy">FUJI</div></div>
</body></html>
